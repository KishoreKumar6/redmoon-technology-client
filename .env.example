# API base URL (leave as /api for same-origin, or set full URL for separate deployments)
VITE_API_URL=/api

# Production
# VITE_API_URL=https://api.redmoontechnology.com/api

# Google Maps Embed Key (optional)
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key

# Google Analytics (optional)
VITE_GA_ID=G-XXXXXXXXXX
